---
import RootLayout from '../layouts/RootLayout.astro';
import GallerySection from '../components/sections/GallerySection.astro';

import { getDict, resolveLocale, LOCALE_COOKIE } from '../i18n/dictionary';

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);
---

<RootLayout
  title={d.meta.galleryTitle}
  description={d.meta.galleryDesc}
  currentPath="/gallery"
>
  <div class="pt-20">
    <GallerySection locale={locale} />
  </div>
</RootLayout>
