---
import RootLayout from '../layouts/RootLayout.astro';
import ScheduleSplitGrid from '../components/islands/ScheduleSplitGrid';

import { getDict, resolveLocale, LOCALE_COOKIE } from '../i18n/dictionary';

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);
---

<RootLayout
  title={d.meta.scheduleTitle}
  description={d.meta.scheduleDesc}
  currentPath="/schedule"
>
  <div class="pt-28 pb-20 px-4 sm:px-8">
    <ScheduleSplitGrid client:load locale={locale} />
  </div>
</RootLayout>
