---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSettingsIsland from '../../components/islands/AdminSettingsIsland';
import { getDict, resolveLocale, LOCALE_COOKIE } from '../../i18n/dictionary';

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);
---

<AdminLayout
  title={d.meta.adminSettingsTitle}
  description={d.meta.adminSettingsDesc}
>
  <AdminSettingsIsland client:load locale={locale} />
</AdminLayout>
