---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminHomeIsland from '../../components/islands/AdminHomeIsland';
import { getDict, resolveLocale, LOCALE_COOKIE } from '../../i18n/dictionary';

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);
---

<AdminLayout
  title={d.meta.adminHomeTitle}
  description={d.meta.adminHomeDesc}
>
  <AdminHomeIsland client:load locale={locale} />
</AdminLayout>
