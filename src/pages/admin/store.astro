---
import RootLayout from '../../layouts/RootLayout.astro';
import AdminStoreIsland from '../../components/islands/AdminStoreIsland';
import { getDict, resolveLocale, LOCALE_COOKIE } from '../../i18n/dictionary';

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);

// Halaman admin Store, sepasang dengan /admin/schedules.
// Sengaja TIDAK di-prerender: gate admin dicek di browser lewat sesi
// Supabase (lihat AdminStoreIsland + authService.getSupabaseAdminProfile),
// dan penegakan tulisnya ada di RLS Supabase (policy admin products).
---

<RootLayout
  title={d.meta.adminStoreTitle}
  description={d.meta.adminStoreDesc}
  currentPath="/admin/store"
  solidHeader={true}
>
  <div class="relative min-h-[calc(100vh-80px)] pt-24 sm:pt-28 pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-[#FCFAF5]">
    <AdminStoreIsland client:load locale={locale} />
  </div>
</RootLayout>
