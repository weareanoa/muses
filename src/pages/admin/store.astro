---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminStoreIsland from '../../components/islands/AdminStoreIsland';
import { getDict, resolveLocale, LOCALE_COOKIE } from '../../i18n/dictionary';

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);
---

<AdminLayout
  title={d.meta.adminStoreTitle}
  description={d.meta.adminStoreDesc}
>
  <AdminStoreIsland client:load locale={locale} />
</AdminLayout>
