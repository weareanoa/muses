---
import RootLayout from '../../layouts/RootLayout.astro';
import AdminScheduleIsland from '../../components/islands/AdminScheduleIsland';
import { getDict, resolveLocale, LOCALE_COOKIE } from '../../i18n/dictionary';

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);

// Halaman ini sengaja TIDAK di-prerender: gate admin dicek di browser
// lewat sesi Supabase (lihat AdminScheduleIsland + authService
// .getSupabaseAdminProfile), dan penegakan tulisnya ada di RLS Supabase.
// Jangan pernah mengandalkan "menyembunyikan link admin" sebagai
// keamanan: yang melindungi data adalah policy admin di database.
---

<RootLayout
  title={d.meta.adminSchedulesTitle}
  description={d.meta.adminSchedulesDesc}
  currentPath="/admin/schedules"
  solidHeader={true}
  hideNavbar={true}
>
  <div class="relative min-h-screen pt-8 sm:pt-10 pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-[#FCFAF5]">
    <AdminScheduleIsland client:load locale={locale} />
  </div>
</RootLayout>
