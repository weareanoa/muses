---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminScheduleIsland from '../../components/islands/AdminScheduleIsland';
import { getDict, resolveLocale, LOCALE_COOKIE } from '../../i18n/dictionary';

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);
---

<AdminLayout
  title={d.meta.adminSchedulesTitle}
  description={d.meta.adminSchedulesDesc}
>
  <AdminScheduleIsland client:load locale={locale} />
</AdminLayout>
