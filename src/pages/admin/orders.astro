---
import RootLayout from '../../layouts/RootLayout.astro';
import AdminOrdersIsland from '../../components/islands/AdminOrdersIsland';
import { getDict, resolveLocale, LOCALE_COOKIE } from '../../i18n/dictionary';

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);
---

<RootLayout
  title={d.meta.adminOrdersTitle}
  description={d.meta.adminOrdersDesc}
  currentPath="/admin/orders"
  solidHeader={true}
  hideNavbar={true}
>
  <div class="relative min-h-screen pt-8 sm:pt-10 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-[#FCFAF5]">
    <AdminOrdersIsland client:load locale={locale} />
  </div>
</RootLayout>
