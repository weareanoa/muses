---
import RootLayout from '../../layouts/RootLayout.astro';
import AdminLoginIsland from '../../components/islands/AdminLoginIsland';
import { getDict, resolveLocale, LOCALE_COOKIE } from '../../i18n/dictionary';

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);

// Halaman login KHUSUS admin, terpisah dari /login publik.
// Sengaja TIDAK di-prerender: status sesi dicek di browser lewat
// authService.getSupabaseAdminProfile, sama seperti /admin/schedules.
---

<RootLayout
  title={d.meta.adminLoginTitle}
  description={d.meta.adminLoginDesc}
  currentPath="/admin/login"
  solidHeader={true}
>
  <div class="relative min-h-[calc(100vh-80px)] pt-24 sm:pt-28 pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-[#FCFAF5]">
    <AdminLoginIsland client:load locale={locale} />
  </div>
</RootLayout>
