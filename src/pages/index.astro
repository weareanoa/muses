---
import RootLayout from '../layouts/RootLayout.astro';
import Hero from '../components/sections/Hero.astro';
import VinylPlayer from '../components/islands/VinylPlayer';
import ScheduleTimeline from '../components/sections/ScheduleTimeline.astro';
import GallerySection from '../components/sections/GallerySection.astro';
import ShopPreview from '../components/sections/ShopPreview.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import FooterCTA from '../components/sections/FooterCTA.astro';
---

<RootLayout
  title="MUSES | Official Idol Group"
  description="Situs profil resmi idol grup lokal MUSES (7 member: Aria, Clara, Stella, Faril, Maya, Reva, Zia). Musik, jadwal tur, galeri, merchandise, dan kontak manajemen."
  currentPath="/"
>
  <Hero />

  <section id="discography" data-section="discography" class="relative w-full overflow-hidden">
    <VinylPlayer client:visible />
  </section>

  <ScheduleTimeline />

  <GallerySection />

  <ShopPreview />

  <ContactSection />

  <FooterCTA />
</RootLayout>
