---
import RootLayout from '../layouts/RootLayout.astro';
import ProfileIsland from '../components/islands/ProfileIsland';
---

<RootLayout
  title="Profil Member CIRCLE | MUSES Official Portal"
  description="Kartu keanggotaan digital resmi MUSES CIRCLE, preferensi bias, dan pengaturan profil penggemar."
  currentPath="/profile"
  solidHeader={true}
>
  <div class="relative min-h-[90vh] pt-28 pb-20 px-4 sm:px-6 flex items-center justify-center overflow-hidden bg-[#FCFAF5]">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-[#F7E08F]/20 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="relative z-10 w-full max-w-4xl mx-auto">
      <ProfileIsland client:load />
    </div>
  </div>
</RootLayout>
