---
import RootLayout from '../layouts/RootLayout.astro';
import ProfileIsland from '../components/islands/ProfileIsland';
---

<RootLayout
  title="Profil Saya | MUSES Official"
  description="Kelola informasi profil Anda untuk mengontrol, melindungi dan mengamankan akun."
  currentPath="/profile"
  solidHeader={true}
>
  <div class="relative min-h-[calc(100vh-80px)] pt-24 sm:pt-28 pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-[#FCFAF5]">
    <ProfileIsland client:load />
  </div>
</RootLayout>
