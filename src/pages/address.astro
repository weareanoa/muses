---
import { withBase } from '../lib/paths';

const target = withBase('/profile?tab=alamat');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Redirecting to Alamat...</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body class="bg-[#FCFAF5] flex items-center justify-center min-h-screen text-[#1F1A12] text-sm">
    <p>Mengalihkan ke halaman alamat... <a href={target} class="text-[#C9971C] underline font-semibold">Klik di sini jika tidak beralih otomatis</a></p>
  </body>
</html>
