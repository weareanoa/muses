---
import { withBase } from '../lib/paths';
import RootLayout from '../layouts/RootLayout.astro';
import PageBackdrop from '../components/ui/PageBackdrop.astro';
import HistoryIsland from '../components/islands/HistoryIsland';

import { getDict, resolveLocale, LOCALE_COOKIE } from '../i18n/dictionary';

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);
---

<RootLayout
  title={d.meta.ordersTitle}
  description={d.meta.ordersDesc}
  solidHeader={true}
>
  <div class="relative min-h-[calc(100vh-80px)] pt-28 pb-24 px-4 sm:px-6 max-w-7xl mx-auto overflow-hidden bg-[#FCFAF5]">
    <PageBackdrop variant="dots" />

    <div class="relative z-10 mb-4">
      <div class="flex items-center justify-between text-xs text-[#6E6453]">
        <a href={withBase("/store")} class="inline-flex items-center gap-1.5 hover:text-[#1F1A12] transition-colors group">
          <span class="group-hover:-translate-x-1 transition-transform">←</span>
          <span>{d.common.backToStore}</span>
        </a>
        <div class="flex items-center gap-3">
          <a href={withBase("/checkout")} class="hover:text-[#9A7420] transition-colors font-medium">{d.common.checkout}</a>
          <span class="text-[#A3977F]">•</span>
          <a href={withBase("/store")} class="hover:text-[#9A7420] transition-colors">{d.common.officialMerch}</a>
        </div>
      </div>
    </div>

    <div class="relative z-10">
      <HistoryIsland client:load locale={locale} />
    </div>
  </div>
</RootLayout>

