---
import RootLayout from '../layouts/RootLayout.astro';
import VinylPlayer from '../components/islands/VinylPlayer';

import { getDict, resolveLocale, LOCALE_COOKIE } from '../i18n/dictionary';

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);
---

<RootLayout
  title={d.meta.discographyTitle}
  description={d.meta.discographyDesc}
  currentPath="/discography"
>
  <div class="relative min-h-[calc(100vh-80px)] pt-16 overflow-hidden">
    <VinylPlayer client:load locale={locale} />
  </div>
</RootLayout>
