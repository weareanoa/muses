---
import RootLayout from '../layouts/RootLayout.astro';
import AddressIsland from '../components/islands/AddressIsland';

import { getDict, resolveLocale, LOCALE_COOKIE } from '../i18n/dictionary';

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);
---

<RootLayout
  title={d.meta.checkoutTitle}
  description={d.meta.checkoutDesc}
  solidHeader={true}
>
  <div class="relative min-h-[calc(100vh-80px)] pt-28 pb-24 px-4 sm:px-8 max-w-6xl mx-auto bg-[#FCFAF5]">
    <div class="w-full border-t border-[#DFC478]/80 mb-6"></div>
    <h1 class="text-4xl sm:text-5xl font-['Playfair_Display',serif] text-[#1F1A12] mb-8 font-normal tracking-tight">
      {d.common.checkout}.
    </h1>

    <div class="relative z-10">
      <AddressIsland client:load locale={locale} />
    </div>
  </div>
</RootLayout>
