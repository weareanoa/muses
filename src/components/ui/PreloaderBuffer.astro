---
import { withBase } from '../../lib/paths';
import { getDict, type Locale } from '../../i18n/dictionary';

interface Props {
  locale?: Locale;
}

const { locale = 'id' } = Astro.props;
const d = getDict(locale).preloader;
---

<div
  id="muses-preloader"
  data-stage={d.stage}
  data-charm={d.charm}
  data-harmony={d.harmony}
  data-welcome={d.welcome}
  class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-[#FCFAF5] transition-all duration-700 ease-out select-none"
  aria-label={d.aria}
  role="status"
>
  <div class="absolute inset-0 bg-gradient-to-b from-[#FCFAF5] via-[#FDF8EE] to-[#FCFAF5] pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-r from-[#F7E08F]/25 via-[#C9971C]/15 to-[#F7E08F]/25 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="relative z-10 flex flex-col items-center max-w-sm px-6 text-center">
    <div class="relative mb-8 flex items-center justify-center">
      <div class="absolute inset-0 -m-4 bg-[#C9971C]/20 rounded-full blur-2xl animate-pulse"></div>
      <img
        id="preloader-logo"
        src={withBase("/images/muses_logo_3d_clean.svg")}
        alt="MUSES"
        class="w-[220px] sm:w-[280px] h-auto object-contain drop-shadow-[0_10px_25px_rgba(201,151,28,0.3)] transition-transform duration-500 will-change-transform"
      />
    </div>

    <div class="w-64 sm:w-72 h-1.5 bg-[#EAE2D0] rounded-full overflow-hidden p-0.5 relative shadow-inner mb-4">
      <div
        id="preloader-progress-bar"
        class="h-full bg-gradient-to-r from-[#C9971C] via-[#F7E08F] to-[#C9971C] rounded-full transition-all duration-300 ease-out shadow-[0_0_12px_rgba(201,151,28,0.7)]"
        style="width: 0%;"
      ></div>
    </div>

    <div class="flex items-center justify-between w-64 sm:w-72 text-xs font-medium text-[#6E6453]">
      <span id="preloader-status" class="tracking-wide text-[11px] uppercase text-[#8C6A1C] transition-opacity duration-300">
        {d.stage}
      </span>
      <span id="preloader-percent" class="font-mono font-bold text-[#C9971C]">
        0%
      </span>
    </div>

    <div class="mt-6 flex items-center gap-1.5 text-amber-400 text-xs">
      <span class="animate-bounce" style="animation-delay: 0ms">✦</span>
      <span class="animate-bounce" style="animation-delay: 150ms">✦</span>
      <span class="animate-bounce" style="animation-delay: 300ms">✦</span>
    </div>
  </div>
</div>

<script>
  import { withBase } from '../../lib/paths';

  const criticalAssets: string[] = [
    withBase('/images/muses_logo_3d_clean.svg'),
    withBase('/images/muses_group_frame1.svg'),
    withBase('/images/members/faril.webp'),
    withBase('/images/members/vira.webp'),
    withBase('/images/members/vely.webp'),
    withBase('/images/members/mine.webp'),
    withBase('/images/members/ndah.webp'),
    withBase('/images/members/liz.webp'),
    withBase('/images/members/lia.webp'),
    withBase('/images/albums/BERSAMA MIMPI ART COVER.webp'),
    withBase('/images/albums/LANGKAH KITA ART COVER.webp'),
    withBase('/images/albums/RASA TERPENDAM ART COVER.webp'),
    withBase('/images/albums/MENUJU CAHAYA ART COVER.webp'),
    withBase('/decor/butterfly.svg'),
    withBase('/decor/pita.svg'),
    withBase('/decor/rose.svg'),
    withBase('/decor/tulip.svg'),
    withBase('/decor/sun.svg'),
    withBase('/decor/owl.svg'),
    withBase('/decor/whale.svg'),
  ];

  function runPreloaderBuffer() {
    const preloader = document.getElementById('muses-preloader');
    const progressBar = document.getElementById('preloader-progress-bar');
    const progressPercent = document.getElementById('preloader-percent');
    const statusText = document.getElementById('preloader-status');

    if (!preloader) return;

    document.body.style.overflow = 'hidden';

    let loadedCount = 0;
    const totalAssets = criticalAssets.length + 1; // +1 for fonts
    let currentDisplayPercent = 0;
    let isFinished = false;

    const startTime = performance.now();
    const minBufferTime = 700; // ms minimum buffer to show smooth transition
    const maxSafetyTimeout = 2500; // ms max wait before forcing unlock

    function updateProgressUI(targetPercent: number) {
      if (isFinished) return;
      targetPercent = Math.min(100, Math.max(currentDisplayPercent, targetPercent));
      currentDisplayPercent = targetPercent;

      if (progressBar) {
        progressBar.style.width = `${targetPercent}%`;
      }
      if (progressPercent) {
        progressPercent.textContent = `${Math.round(targetPercent)}%`;
      }

      if (statusText) {
        const stage = preloader?.dataset.stage || 'Menyiapkan panggung...';
        const charm = preloader?.dataset.charm || 'Memuat pesona para muse...';
        const harmony = preloader?.dataset.harmony || 'Menyelaraskan harmoni...';
        const welcome = preloader?.dataset.welcome || 'Selamat datang di MUSES';
        if (targetPercent < 35) {
          statusText.textContent = stage;
        } else if (targetPercent < 70) {
          statusText.textContent = charm;
        } else if (targetPercent < 100) {
          statusText.textContent = harmony;
        } else {
          statusText.textContent = welcome;
        }
      }
    }

    function checkItemLoaded() {
      loadedCount++;
      const percent = (loadedCount / totalAssets) * 100;
      updateProgressUI(percent);

      if (loadedCount >= totalAssets) {
        completePreloader();
      }
    }

    function completePreloader() {
      if (isFinished) return;
      isFinished = true;
      updateProgressUI(100);

      const elapsedTime = performance.now() - startTime;
      const remainingDelay = Math.max(0, minBufferTime - elapsedTime);

      setTimeout(() => {
        if (progressBar) progressBar.style.width = '100%';
        if (progressPercent) progressPercent.textContent = '100%';

        setTimeout(() => {
          preloader.classList.add('opacity-0', 'scale-105', 'pointer-events-none');
          document.body.style.overflow = '';

          window.dispatchEvent(new CustomEvent('muses-preloader-done'));

          if (typeof window !== 'undefined' && (window as any).ScrollTrigger) {
            (window as any).ScrollTrigger.refresh();
          }

          setTimeout(() => {
            preloader.remove();
          }, 700);
        }, 180);
      }, remainingDelay);
    }

    // Preload fonts
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready
        .then(() => checkItemLoaded())
        .catch(() => checkItemLoaded());
    } else {
      checkItemLoaded();
    }

    // Preload and decode images
    criticalAssets.forEach((src) => {
      const img = new Image();
      img.src = src;

      if (img.decode) {
        img.decode()
          .then(() => checkItemLoaded())
          .catch(() => checkItemLoaded());
      } else {
        img.onload = () => checkItemLoaded();
        img.onerror = () => checkItemLoaded();
      }
    });

    // Safety timeout
    setTimeout(() => {
      if (!isFinished) {
        completePreloader();
      }
    }, maxSafetyTimeout);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runPreloaderBuffer);
  } else {
    runPreloaderBuffer();
  }
</script>

