---
import ScheduleSplitGrid from '../islands/ScheduleSplitGrid';
import type { Locale } from '../../i18n/dictionary';

interface Props {
  locale?: Locale;
}

const { locale = 'id' } = Astro.props;
---

<section id="schedule" data-section="schedule" class="relative bg-[#FCFAF5] border-t border-[#C9971C]/20 overflow-clip">
  <ScheduleSplitGrid client:visible locale={locale} />
</section>
