---
import { withBase } from '../../lib/paths';
import { getDict, type Locale } from '../../i18n/dictionary';

interface Props {
  locale?: Locale;
}

const { locale = 'id' } = Astro.props;
const d = getDict(locale).footer;
---

<footer class="bg-[#F8F4EA] border-t border-[#C9971C]/25 text-[#1F1A12] pt-20 pb-12">
  <div class="max-w-7xl mx-auto px-6 sm:px-12">
    <div class="flex flex-col lg:flex-row lg:items-start gap-10 lg:gap-16">
      <div class="max-w-xl space-y-4">
        <a href={withBase("/")} aria-label={d.homeAria}>
          <img
            src={withBase("/images/muses_logo_3d_clean.svg")}
            alt="MUSES"
            class="h-10 w-auto object-contain"
          />
        </a>
        <p class="text-sm text-[#6E6453] leading-relaxed text-pretty">
          {d.tagline}
        </p>
        <div class="text-[11px] text-[#6E6453] space-y-1">
          <p>{d.copyright1}</p>
          <p>{d.copyright2}</p>
        </div>
      </div>

      <div class="lg:ml-auto space-y-4">
        <p class="text-xs font-bold uppercase text-[#8C6A1C]">{d.follow}</p>
        <ul class="space-y-2 text-sm text-[#6E6453] font-medium">
          <li>
            <a href="https://instagram.com/muses.official" target="_blank" rel="noopener noreferrer" class="hover:text-[#C9971C] transition-colors">
              Instagram @muses.official
            </a>
          </li>
          <li>
            <a href="https://tiktok.com/@muses.official" target="_blank" rel="noopener noreferrer" class="hover:text-[#C9971C] transition-colors">
              TikTok @muses.official
            </a>
          </li>
          <li>
            <a href="https://youtube.com/@muses.official" target="_blank" rel="noopener noreferrer" class="hover:text-[#C9971C] transition-colors">
              YouTube @muses.official
            </a>
          </li>
        </ul>
        <p class="text-xs text-[#6E6453] leading-relaxed">
          {d.businessPrefix} <a href="mailto:dania@muses.id" class="font-medium hover:text-[#C9971C] transition-colors">dania@muses.id</a>
        </p>
      </div>
    </div>

  </div>
</footer>
