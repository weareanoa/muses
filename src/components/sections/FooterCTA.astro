---
import { withBase } from '../../lib/paths';
import { getDict, type Locale } from '../../i18n/dictionary';
import { gmailComposeLink } from '../../lib/contact';

interface Props {
  locale?: Locale;
}

const { locale = 'id' } = Astro.props;
const dict = getDict(locale);
const d = dict.footer;
const gmailUrl = gmailComposeLink(dict.contact.emailSubject, dict.contact.emailBody);
---

<footer class="bg-[#F8F4EA] border-t border-[#C9971C]/25 text-[#1F1A12] pt-20 pb-12">
  <div class="max-w-7xl mx-auto px-6 sm:px-12">
    <div class="flex flex-col lg:flex-row lg:items-start gap-10 lg:gap-16">
      <div class="max-w-xl space-y-4">
        <a href={withBase("/")} aria-label={d.homeAria} class="inline-block -ml-[10px]">
          <img
            src={withBase("/images/muses_logo_3d_clean.webp")}
            alt="MUSES"
            class="h-10 w-auto object-contain"
            width="1350"
            height="365"
          />
        </a>
        <p class="text-sm text-[#6E6453] leading-relaxed text-pretty">
          {d.tagline}
        </p>
        <div class="text-[11px] text-[#6E6453] space-y-1">
          <p>{d.copyright1}</p>
          <p>{d.copyright2}</p>
        </div>
      </div>

      <div class="lg:ml-auto space-y-4">
        <p class="text-xs font-bold uppercase text-[#8C6A1C]">{d.follow}</p>
        <ul class="space-y-2.5 text-sm text-[#6E6453] font-medium">
          <li>
            <a href="https://instagram.com/official.muses" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2.5 hover:text-[#C9971C] transition-colors">
              <img src={withBase("/icon/Instagram.svg")} alt="" class="w-4 h-4 object-contain opacity-80 group-hover:opacity-100 transition-opacity shrink-0" aria-hidden="true" />
              <span>@official.muses</span>
            </a>
          </li>
          <li>
            <a href="https://tiktok.com/@muses.official" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2.5 hover:text-[#C9971C] transition-colors">
              <img src={withBase("/icon/TikTok.svg")} alt="" class="w-4 h-4 object-contain opacity-80 group-hover:opacity-100 transition-opacity shrink-0" aria-hidden="true" />
              <span>@muses.official</span>
            </a>
          </li>
          <li>
            <a href="https://youtube.com/@muses.official" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2.5 hover:text-[#C9971C] transition-colors">
              <img src={withBase("/icon/YouTube.svg")} alt="" class="w-4 h-4 object-contain opacity-80 group-hover:opacity-100 transition-opacity shrink-0" aria-hidden="true" />
              <span>@muses.official</span>
            </a>
          </li>
          <li>
            <a href="https://x.com/muses_ofc" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2.5 hover:text-[#C9971C] transition-colors">
              <img src={withBase("/icon/X (Twitter).svg")} alt="" class="w-4 h-4 object-contain opacity-80 group-hover:opacity-100 transition-opacity shrink-0" aria-hidden="true" />
              <span>@muses_ofc</span>
            </a>
          </li>
        </ul>
        <p class="text-xs text-[#6E6453] leading-relaxed">
          {d.businessPrefix} <a href={gmailUrl} target="_blank" rel="noopener noreferrer" class="font-medium hover:text-[#C9971C] transition-colors">theamusing.muses@gmail.com</a>
        </p>
      </div>
    </div>

  </div>
</footer>
