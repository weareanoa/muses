---
import { withBase } from '../../lib/paths';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import productsData from '../../data/products.json';
---

<section id="shop-preview-section" class="relative bg-[#FCFAF5] py-24 px-4 sm:px-8 border-t border-[#C9971C]/20 overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <SectionHeading
        subtitle="Official Merchandise"
        title="MERCHANDISE RESMI MUSES"
        align="left"
        class="mb-0 md:mb-0"
      />
      <div class="mt-6 md:mt-0">
        <Button href="/store" variant="outline" size="md">
          Lihat Semua Produk →
        </Button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {
        productsData.slice(0, 3).map((product) => (
          <a
            href={withBase(`/store/${product.id}`)}
            class="group relative bg-white border border-[#C9971C]/25 rounded-3xl overflow-hidden hover:border-[#C9971C] transition-all duration-300 hover:shadow-[0_15px_35px_rgba(201,151,28,0.18)] hover:-translate-y-1 flex flex-col"
          >
            <div class="relative aspect-square w-full bg-[#FDF6E7] overflow-hidden">
              <img
                src={product.image}
                alt={product.name}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60 group-hover:opacity-30 transition-opacity" />

              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 rounded-full text-[10px] font-bold tracking-widest uppercase bg-white/90 backdrop-blur-md text-[#8C6A1C] border border-[#C9971C]/30 shadow-xs">
                  {product.category}
                </span>
              </div>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <h3 class="text-base font-bold text-[#1F1A12] group-hover:text-[#C9971C] transition-colors line-clamp-1">
                  {product.name}
                </h3>
                <p class="text-xs text-[#6E6453] mt-1 line-clamp-2 leading-relaxed">
                  {product.description}
                </p>
              </div>

              <div class="flex items-center justify-between pt-3 border-t border-[#C9971C]/20">
                <div>
                  <span class="text-[10px] text-[#8A7F6C] uppercase font-mono block">Harga Resmi</span>
                  <span class="text-base font-bold font-mono text-[#1F1A12]">
                    Rp {(Math.round(product.price * 16000)).toLocaleString('id-ID')}
                  </span>
                </div>
                <span class="text-xs font-semibold text-[#C9971C] group-hover:translate-x-1 transition-transform">
                  Detail →
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
