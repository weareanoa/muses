---
---

<div
  id="brand-preloader"
  class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-[#FCFAF5] text-[#1F1A12] select-none overflow-hidden"
>
  <div class="absolute inset-0 pointer-events-none z-0">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[750px] h-[500px] bg-gradient-to-b from-[#F7E08F]/40 via-[#C9971C]/15 to-transparent rounded-full blur-[140px]"></div>
    <div class="absolute top-12 left-12 text-[#C9971C] text-2xl opacity-60">✦</div>
    <div class="absolute top-28 right-16 text-[#C9971C] text-3xl opacity-60">✦</div>
    <div class="absolute bottom-32 left-16 text-[#C9971C] text-xl opacity-60">✦</div>
    <div class="absolute bottom-20 right-20 text-[#C9971C] text-2xl opacity-60">✦</div>
  </div>

  <div class="absolute top-6 right-6 z-30">
    <button
      id="skip-preloader"
      type="button"
      class="px-4 py-1.5 rounded-full bg-white/80 border border-[#C9971C]/40 text-xs font-mono text-[#6E6453] hover:text-[#1F1A12] hover:bg-white shadow-xs transition-all cursor-pointer flex items-center gap-1.5 backdrop-blur-xs"
    >
      <span>Lewati Intro</span>
      <span class="text-[10px] text-[#8C6A1C]">[Esc]</span>
    </button>
  </div>

  <div id="preloader-content-wrap" class="relative z-20 flex flex-col items-center justify-center w-full px-4 my-auto">
    <div id="preloader-title-container" class="relative flex items-center justify-center will-change-transform">
      <span
        id="preloader-muses-title"
        class="text-[90px] sm:text-[150px] md:text-[200px] lg:text-[240px] font-display font-black tracking-widest gold-gradient-text select-none text-center leading-none will-change-transform drop-shadow-[0_15px_40px_rgba(201,151,28,0.35)]"
      >
        MUSES
      </span>
    </div>

    <div id="preloader-meta-wrap" class="flex flex-col items-center justify-center mt-6 will-change-transform">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2 h-2 rounded-full gold-gradient-bg animate-ping"></span>
        <span class="text-xs sm:text-sm font-mono font-bold tracking-[0.3em] uppercase text-[#8C6A1C]">
          OFFICIAL IDOL GROUP
        </span>
      </div>

      <div class="w-48 sm:w-64 bg-[#C9971C]/25 h-1 rounded-full overflow-hidden">
        <div id="preloader-progress-bar" class="h-full gold-gradient-bg w-0"></div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initPreloader } from '../../animations/preloader';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initPreloader());
  } else {
    initPreloader();
  }
</script>
