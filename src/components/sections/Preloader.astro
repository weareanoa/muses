---
---

<div
  id="brand-preloader"
  class="fixed inset-0 z-[100] flex flex-col items-center justify-between bg-gradient-to-b from-[#FFFDF9] via-[#FCFAF5] to-[#F7E08F]/50 text-[#1F1A12] select-none overflow-hidden transition-opacity duration-700"
>
  <div class="absolute inset-0 pointer-events-none z-0">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-gradient-to-b from-[#F7E08F]/40 to-transparent rounded-full blur-[120px]"></div>
    <div class="absolute top-12 left-12 text-[#C9971C] text-2xl animate-pulse">✦</div>
    <div class="absolute top-28 right-16 text-[#C9971C] text-3xl animate-pulse delay-300">✦</div>
    <div class="absolute bottom-32 left-16 text-[#C9971C] text-xl animate-pulse delay-500">✦</div>
    <div class="absolute top-1/2 right-8 text-[#C9971C] text-2xl animate-pulse delay-700">✦</div>
  </div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pt-6 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full gold-gradient-bg animate-ping"></span>
      <span class="text-xs font-mono font-bold tracking-[0.25em] uppercase text-[#8C6A1C]">
        MUSES OFFICIAL PROFILE
      </span>
    </div>

    <button
      id="skip-preloader"
      type="button"
      class="px-4 py-1.5 rounded-full bg-white/80 border border-[#C9971C]/40 text-xs font-mono text-[#6E6453] hover:text-[#1F1A12] hover:bg-white shadow-xs transition-all cursor-pointer flex items-center gap-1.5 backdrop-blur-xs"
    >
      <span>Lewati Intro</span>
      <span class="text-[10px] text-[#8C6A1C]">[Esc]</span>
    </button>
  </div>

  <div class="relative z-10 w-full max-w-4xl mx-auto px-4 flex flex-col items-center justify-center flex-1 my-auto">
    <div id="preloader-logo-container" class="relative z-20 flex flex-col items-center will-change-transform">
      <img
        id="preloader-logo-img"
        src="/images/muses_logo_3d_clean.png"
        alt="MUSES"
        class="w-[280px] sm:w-[420px] md:w-[500px] object-contain drop-shadow-[0_15px_30px_rgba(201,151,28,0.35)] will-change-transform"
      />
    </div>

    <div id="preloader-group-container" class="relative z-10 -mt-10 sm:-mt-16 w-full max-w-[620px] will-change-transform">
      <img
        id="preloader-group-img"
        src="/images/muses_group_frame1.png"
        alt="MUSES 7 Members"
        class="w-full h-auto object-contain drop-shadow-[0_20px_40px_rgba(31,26,18,0.2)]"
      />
    </div>
  </div>

  <div class="relative z-10 w-full max-w-md mx-auto px-6 pb-8 flex flex-col items-center">
    <div class="w-full bg-[#C9971C]/20 h-1 rounded-full overflow-hidden mb-2.5">
      <div id="preloader-progress-bar" class="h-full gold-gradient-bg w-0 transition-all ease-linear"></div>
    </div>
    <span class="text-[10px] font-mono tracking-[0.3em] uppercase text-[#8C6A1C] font-semibold">
      HARMONI 7 MEMBER • MEMUAT PENGALAMAN
    </span>
  </div>
</div>

<script>
  import { initPreloader } from '../../animations/preloader';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initPreloader());
  } else {
    initPreloader();
  }
</script>
