---
import GalleryGrid from '../islands/GalleryGrid';
import { getDict, type Locale } from '../../i18n/dictionary';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const d = getDict(locale).home;
---

<section id="gallery" data-section="gallery" class="relative bg-[#FCFAF5] py-8 sm:py-24 px-2.5 sm:px-8 border-t border-[#C9971C]/20 overflow-hidden">
  <div class="max-w-6xl mx-auto relative z-10">
    <div class="mb-3 sm:mb-6 px-1">
      <h2 class="font-balbes text-3xl min-[380px]:text-4xl sm:text-6xl md:text-7xl lg:text-8xl text-[#1F1A12] leading-none tracking-normal select-none text-left">
        {d.galleryTitle}
      </h2>
    </div>

    <GalleryGrid client:visible locale={locale} />
  </div>
</section>
