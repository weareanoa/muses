---
import GalleryGrid from '../islands/GalleryGrid';
---

<section id="gallery" data-section="gallery" class="relative bg-[#FCFAF5] py-24 px-4 sm:px-8 border-t border-[#C9971C]/20 overflow-hidden">
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[850px] h-[400px] bg-[#F7E08F]/15 rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-xs font-mono font-bold tracking-[0.3em] uppercase text-[#C9971C] block mb-2">
        OUR LITTLE UNIVERSE
      </span>

      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif-display font-black tracking-tight text-[#1F1A12] mb-3">
        Little Moments, Endless Memories.
      </h2>

      <p class="text-xs sm:text-sm text-[#6E6453] max-w-xl mx-auto leading-relaxed">
        From little behind-the-scenes moments to unforgettable days with our favorite stars.
      </p>
    </div>

    <GalleryGrid client:visible />
  </div>
</section>
