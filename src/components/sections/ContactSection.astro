---
import { withBase } from '../../lib/paths';
import SocialCard from '../ui/SocialCard.astro';
---

<section id="kontak-section" class="relative bg-[#FCFAF5] py-20 px-4 sm:px-8 overflow-hidden">
  <div class="max-w-7xl mx-auto space-y-12 relative z-10">
    <div class="relative rounded-3xl overflow-hidden gold-gradient-banner p-8 sm:p-12 lg:p-16 text-[#1F1A12] shadow-[0_20px_60px_rgba(201,151,28,0.22)] border border-[#C9971C]/40">
      <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-white/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
        <div class="lg:col-span-7 space-y-4">
          <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/30 backdrop-blur-md border border-white/40 text-[11px] font-mono tracking-[0.25em] uppercase font-bold text-[#1F1A12]">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 3l1.912 5.885h6.188l-5.007 3.638 1.913 5.885-5.006-3.637-5.006 3.637 1.913-5.885-5.007-3.638h6.188z"/>
            </svg>
            OFFICIAL CONTACT
          </span>

          <h2 class="text-3xl sm:text-5xl lg:text-6xl font-display font-black tracking-tight uppercase leading-tight text-[#1F1A12]">
            Let's Create Something Beautiful Together
          </h2>

          <p class="text-xs sm:text-sm text-[#3E3218] max-w-xl font-medium leading-relaxed">
            For business inquiries, collaborations, brand partnerships, and event booking, please reach out to the MUSES official management team.
          </p>
        </div>

        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <div class="relative w-full max-w-[380px] rounded-2xl overflow-hidden bg-white/40 border border-white/50 p-2 shadow-xl backdrop-blur-md">
            <img
              src={withBase("/images/muses_group_frame1.svg")}
              alt="MUSES Management & Group"
              class="w-full h-auto object-cover rounded-xl"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 rounded-3xl bg-white border border-[#C9971C]/30 shadow-xl overflow-hidden">
      <div class="md:col-span-6 p-8 sm:p-12 flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl gold-gradient-bg flex items-center justify-center text-[#1F1A12] shadow-md">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>

          <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-[#8C6A1C] font-bold block">
            OFFICIAL MANAGEMENT CONTACT
          </span>

          <h3 class="text-2xl sm:text-3xl font-display font-black text-[#1F1A12] uppercase tracking-tight">
            Your Next Collaboration Starts Here.
          </h3>

          <p class="text-xs text-[#6E6453] italic">
            *for official business inquiries only.
          </p>
        </div>

        <div class="pt-4">
          <a
            href="mailto:dania@muses.id?subject=Collaboration%20Inquiry%20-%20MUSES"
            class="inline-flex items-center justify-center gap-3 py-3.5 px-6 rounded-2xl pill-active text-[#1F1A12] font-mono text-xs uppercase tracking-wider font-bold shadow-md hover:scale-105 active:scale-95 transition-all cursor-pointer"
          >
            <span>Contact (Dania)</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="hidden md:block w-px bg-[#C9971C]/25 my-8"></div>

      <div class="md:col-span-5 p-8 sm:p-12 flex flex-col justify-between space-y-6 bg-[#FCFAF5]/50">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-[#8C6A1C] font-bold block mb-2">
            STAY CONNECTED
          </span>
          <h4 class="text-xl sm:text-2xl font-bold text-[#1F1A12] uppercase font-display mb-6">
            FOLLOW US FOR UPDATE
          </h4>

          <div class="space-y-3.5">
            <SocialCard href="https://instagram.com" name="Instagram" handle="@muses.official">
              <svg slot="icon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
              </svg>
            </SocialCard>

            <SocialCard href="https://tiktok.com" name="TikTok" handle="@muses.official">
              <svg slot="icon" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.89 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.11v-3.52a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3 15.67 6.34 6.34 0 0 0 9.34 22a6.34 6.34 0 0 0 6.34-6.33V9.08a8.28 8.28 0 0 0 4.91 1.58v-3.46a4.88 4.88 0 0 1-1-.51Z"/>
              </svg>
            </SocialCard>

            <SocialCard href="https://youtube.com" name="YouTube" handle="MUSES Official">
              <svg slot="icon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><polygon points="10 15 15 12 10 9 10 15"/>
              </svg>
            </SocialCard>
          </div>
        </div>

        <p class="text-[11px] text-[#8A7F6C]">
          Hak cipta dilindungi undang-undang © 2026 MUSES Official Management.
        </p>
      </div>
    </div>
  </div>
</section>
