---
import { withBase } from '../../lib/paths';
---

<section id="kontak" data-section="kontak" class="relative bg-[#FCFAF5] overflow-hidden">
  <div class="relative w-full overflow-hidden" style="background: linear-gradient(90deg, #B8860B 0%, #F6DD8A 54%, #D4A017 83%, #523C05 100%);">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 flex flex-col lg:flex-row items-center justify-between min-h-[300px] lg:min-h-[360px] relative">
      <div class="py-10 sm:py-14 max-w-xl z-10 font-['Poppins',sans-serif]">
        <span class="block text-[11px] sm:text-xs font-semibold tracking-[0.25em] uppercase text-[#543C0A] mb-3">
          OFFICIAL CONTACT
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-bold text-[#2A1D0B] leading-[1.18] mb-4 tracking-tight">
          Let’s Create Something<br />Beautiful Together
        </h2>
        <p class="text-xs sm:text-[13px] text-[#423218] leading-relaxed max-w-lg font-normal">
          for business inquiries, collaborations, event partnerships, please reach out to the MUSES management team.
        </p>
      </div>

      <div class="w-full lg:w-auto flex justify-center lg:justify-end items-end self-end z-10 pt-4 lg:pt-0">
        <img
          src={withBase("/images/muses_group_frame1.svg")}
          alt="MUSES Idol Group"
          class="h-[220px] sm:h-[280px] md:h-[320px] lg:h-[360px] w-auto object-contain object-bottom select-none pointer-events-none drop-shadow-[0_12px_24px_rgba(0,0,0,0.25)]"
        />
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14 pb-16 sm:pb-20 font-['Poppins',sans-serif]">
    <div class="bg-[#FAF3E3] border border-[#E7D6AF] rounded-3xl sm:rounded-[32px] p-6 sm:p-10 lg:p-12 shadow-[0_4px_25px_rgba(201,151,28,0.06)]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <div class="lg:col-span-7 flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-6">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#EBD8A6]/70 flex items-center justify-center shrink-0">
            <div class="w-11 h-11 sm:w-13 sm:h-13 rounded-full bg-[#C29322] flex items-center justify-center text-[#2A1D0B] shadow-xs">
              <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
            </div>
          </div>

          <div class="space-y-3">
            <div>
              <span class="block text-[11px] font-semibold tracking-[0.2em] uppercase text-[#8E6D24] mb-1">
                OFFICIAL MANAGEMENT CONTACT
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-[#1A140B] leading-tight tracking-tight">
                Your Next Collaboration Starts Here.
              </h3>
              <p class="text-xs text-[#5C4F39] mt-1 font-normal">
                for official business inquiries only.
              </p>
            </div>

            <div class="pt-1">
              <a
                href="mailto:dania@muses.id?subject=Collaboration%20Inquiry%20-%20MUSES"
                class="inline-flex items-center gap-2 px-7 py-2.5 sm:py-3 rounded-full bg-gradient-to-r from-[#B98616] via-[#D3A027] to-[#A37412] hover:brightness-105 active:scale-95 text-[#20180B] font-bold text-xs sm:text-[13px] shadow-sm transition-all cursor-pointer"
              >
                <span>Contact (Dania)</span>
                <span class="text-sm">↗</span>
              </a>
            </div>
          </div>
        </div>

        <div class="hidden lg:block lg:col-span-1 flex justify-center">
          <div class="w-px h-28 bg-[#D8C496]"></div>
        </div>
        <div class="lg:hidden w-full h-px bg-[#D8C496]"></div>

        <div class="lg:col-span-4 space-y-3.5">
          <span class="block text-[11px] font-semibold tracking-[0.2em] uppercase text-[#8E6D24] mb-3">
            FOLLOW US FOR UPDATE
          </span>

          <div class="space-y-3">
            <a
              href="https://instagram.com/muses.official"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3.5 group cursor-pointer"
            >
              <div class="w-9 h-9 rounded-full bg-[#EBD8A6] flex items-center justify-center text-[#73510C] group-hover:scale-105 transition-transform shrink-0">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs sm:text-[13px] font-bold text-[#1A140B] group-hover:text-[#8E6D24] transition-colors">
                  Instagram
                </span>
                <span class="block text-[11px] text-[#52442D]">
                  @muses.official
                </span>
              </div>
            </a>

            <a
              href="https://tiktok.com/@muses.official"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3.5 group cursor-pointer"
            >
              <div class="w-9 h-9 rounded-full bg-[#EBD8A6] flex items-center justify-center text-[#73510C] group-hover:scale-105 transition-transform shrink-0">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs sm:text-[13px] font-bold text-[#1A140B] group-hover:text-[#8E6D24] transition-colors">
                  Tiktok
                </span>
                <span class="block text-[11px] text-[#52442D]">
                  @muses.official
                </span>
              </div>
            </a>

            <a
              href="https://youtube.com/@muses.official"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3.5 group cursor-pointer"
            >
              <div class="w-9 h-9 rounded-full bg-[#EBD8A6] flex items-center justify-center text-[#73510C] group-hover:scale-105 transition-transform shrink-0">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs sm:text-[13px] font-bold text-[#1A140B] group-hover:text-[#8E6D24] transition-colors">
                  YouTube
                </span>
                <span class="block text-[11px] text-[#52442D]">
                  @muses.official
                </span>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
