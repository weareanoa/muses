---
import { withBase, withBaseDeep } from '../../lib/paths';
import membersDataRaw from '../../data/members.json';
const membersData = withBaseDeep(membersDataRaw);

const arcCardConfigs = [
  { rot: -10, y: 22, scale: 0.76, z: 10 },
  { rot: -6, y: 11, scale: 0.78, z: 20 },
  { rot: -2, y: 3, scale: 0.80, z: 30 },
  { rot: 0, y: 0, scale: 0.82, z: 40 },
  { rot: 2, y: 3, scale: 0.80, z: 30 },
  { rot: 6, y: 11, scale: 0.78, z: 20 },
  { rot: 10, y: 22, scale: 0.76, z: 10 },
];
---

<div id="hero-scroll-container" class="relative w-full bg-[#FCFAF5] overflow-visible">
  <section
    id="hero-arc-section"
    class="relative w-full min-h-[92vh] sm:min-h-[96vh] flex flex-col items-center justify-between overflow-visible pt-20 sm:pt-24 pb-4 sm:pb-6 select-none"
  >
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[850px] h-[450px] bg-gradient-to-b from-[#F7E08F]/20 via-[#C9971C]/8 to-transparent rounded-full blur-[140px] pointer-events-none z-0"></div>

    <div class="relative z-10 w-full flex flex-col items-center justify-center pt-2 sm:pt-4 mb-2">
      <span class="text-[120px] font-display font-black tracking-widest gold-gradient-text">
        MUSES
      </span>
    </div>

    <div
      id="cards-viewport-wrap"
      class="relative z-20 w-full max-w-[1380px] mx-auto px-2 sm:px-4 flex flex-col items-center justify-end mt-auto pb-0 overflow-visible"
    >
      <div
        id="active-member-info"
        class="relative z-30 mb-4 sm:mb-6 flex flex-col items-center justify-center text-center select-none transition-all duration-300 min-h-[50px]"
      >
        <div id="info-hover-state" class="hidden flex-col items-center justify-center transition-opacity duration-300">
          <div class="relative flex items-center justify-center">
            <img
              id="active-butterfly-left"
              src={withBase("/images/butterfly_purple.svg")}
              alt="butterfly"
              class="w-6 h-6 sm:w-8 sm:h-8 object-contain mr-3 sm:mr-4 -rotate-12 animate-pulse"
            />
            <h2
              id="active-member-name"
              class="text-2xl sm:text-3xl md:text-4xl font-display font-black tracking-tight text-[#1F1A12] uppercase drop-shadow-xs"
            >
              Member
            </h2>
            <img
              id="active-butterfly-right"
              src={withBase("/images/butterfly_purple.svg")}
              alt="butterfly"
              class="w-6 h-6 sm:w-8 sm:h-8 object-contain ml-3 sm:mr-4 rotate-12 animate-pulse"
            />
          </div>

          <p
            id="active-member-subtitle"
            class="text-xs sm:text-sm font-sans font-medium text-[#4A154B] mt-1 flex items-center justify-center gap-2"
          >
            <span id="active-bullet" class="w-2 h-2 rounded-full bg-[#C9971C]"></span>
            <span id="active-subtitle-text">Muse Title</span>
          </p>
        </div>
      </div>

      <div
        id="arc-cards-track"
        class="flex items-center justify-center gap-1.5 sm:gap-2 md:gap-2 lg:gap-2 xl:gap-2.5 2xl:gap-3 py-1 w-full will-change-transform overflow-visible"
      >
        {
          membersData.map((member, index) => {
            const cfg = arcCardConfigs[index] || { rot: 0, y: 0, scale: 1, z: 10 };
            return (
              <div
                class="muses-hero-card group relative shrink-0 cursor-pointer will-change-transform transition-all duration-300
                  w-[110px] sm:w-[130px] md:w-[145px] lg:w-[155px] xl:w-[170px] 2xl:w-[195px]
                  h-[165px] sm:h-[195px] md:h-[218px] lg:h-[235px] xl:h-[255px] 2xl:h-[292px]
                  rounded-2xl sm:rounded-3xl overflow-hidden
                  bg-white/90 backdrop-blur-xs border-2 border-[#C9971C]/30 shadow-[0_8px_24px_rgba(201,151,28,0.1)]
                "
                style={{
                  transform: `translateY(${cfg.y}px) rotate(${cfg.rot}deg) scale(${cfg.scale})`,
                  zIndex: cfg.z,
                }}
                data-member-id={member.id}
                data-member-index={index}
                data-member-name={member.stageName}
                data-muse-title={member.museTitle || member.role}
                data-theme-color={member.themeColor}
                data-gradient-start={member.gradientStart}
                data-gradient-end={member.gradientEnd || member.themeColor}
                data-bg-tint={member.bgTint || '#FFF'}
                data-icon={member.icon || member.emoticon}
                data-default-rot={cfg.rot}
                data-default-y={cfg.y}
                data-default-scale={cfg.scale}
                data-default-z={cfg.z}
              >
                <div class="hero-neutral-view absolute inset-0 p-3 sm:p-4 flex flex-col justify-between items-center text-center transition-opacity duration-300 group-hover:opacity-0">
                  <div class="w-full flex items-center justify-between text-[#8C6A1C]/60">
                    <span class="text-[9px] sm:text-[10px] font-mono font-bold tracking-widest">
                      0{index + 1}
                    </span>
                    <span class="text-[11px] sm:text-xs font-serif text-[#C9971C]">
                      ✦
                    </span>
                  </div>

                  <div class="my-auto flex flex-col items-center">
                    <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-[#FAF6EC] border border-[#C9971C]/25 shadow-xs flex items-center justify-center text-[#8C6A1C] mb-2">
                      <span class="text-sm sm:text-base font-bold">✦</span>
                    </div>
                    <span class="text-[10px] sm:text-xs font-mono font-bold tracking-widest uppercase text-[#8C6A1C]/75">
                      MUSE
                    </span>
                  </div>

                  <div class="w-full flex justify-center">
                    <span class="w-5 h-0.5 bg-[#C9971C]/30 rounded-full"></span>
                  </div>
                </div>

                <div class="settled-txt-view absolute inset-0 p-3.5 sm:p-4 flex flex-col justify-between text-left opacity-0 transition-opacity duration-300 pointer-events-none group-hover:opacity-0 bg-gradient-to-b from-white/95 via-white/85 to-[#FAF6EC]/95">
                  <div class="w-full flex items-center justify-between">
                    <span class="text-[9px] sm:text-[10px] font-mono font-black tracking-widest text-[#8C6A1C]/70">
                      0{index + 1}
                    </span>
                    <span class="text-xs font-bold" style={{ color: member.themeColor }}>
                      {member.icon || member.emoticon}
                    </span>
                  </div>

                  <div class="my-auto flex flex-col items-center justify-center">
                    <div
                      class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl flex items-center justify-center text-lg sm:text-xl font-bold shadow-xs border"
                      style={{
                        backgroundColor: `${member.themeColor}12`,
                        borderColor: `${member.themeColor}25`,
                        color: member.themeColor,
                      }}
                    >
                      <span>{member.icon || '✦'}</span>
                    </div>
                  </div>

                  <div class="w-full pt-2 border-t border-[#1F1A12]/8">
                    <span
                      class="text-[8px] sm:text-[9px] md:text-[10px] font-mono font-black tracking-widest uppercase block line-clamp-1"
                      style={{ color: member.themeColor }}
                    >
                      {member.role.split(',')[0]}
                    </span>
                    <h3 class="text-base sm:text-lg md:text-xl font-display font-black tracking-wider uppercase text-[#1F1A12] leading-tight mt-0.5">
                      {member.stageName}
                    </h3>
                    <p class="text-[8px] sm:text-[9px] md:text-[10px] font-sans font-medium text-[#6E6453] mt-0.5 line-clamp-1">
                      {member.fullName}
                    </p>
                  </div>
                </div>

                <div
                  class="card-hover-view absolute inset-0 p-3.5 sm:p-4 flex flex-col justify-between opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
                  style={{
                    background: `linear-gradient(155deg, ${member.bgTint || '#FFF'}, ${member.gradientStart}, ${member.gradientEnd || member.themeColor})`,
                  }}
                >
                  <div class="w-full flex items-center justify-between text-[#1F1A12]/80">
                    <span class="text-[9px] sm:text-[10px] font-mono font-black tracking-widest">
                      0{index + 1}
                    </span>
                    <span class="text-xs sm:text-sm font-bold">
                      {member.icon || member.emoticon}
                    </span>
                  </div>

                  <div class="my-auto flex flex-col items-center justify-center">
                    <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-white/90 shadow-sm flex items-center justify-center text-lg sm:text-xl font-bold text-[#1F1A12] border border-white">
                      <span>{member.icon || '✦'}</span>
                    </div>
                  </div>

                  <div class="w-full pt-2 border-t border-[#1F1A12]/15">
                    <span class="text-[8px] sm:text-[9px] md:text-[10px] font-mono font-black tracking-widest uppercase text-[#1F1A12]/85 block line-clamp-1">
                      {member.role.split(',')[0]}
                    </span>
                    <h3 class="text-base sm:text-lg md:text-xl font-display font-black tracking-wider uppercase text-[#1F1A12] leading-tight drop-shadow-xs mt-0.5">
                      {member.stageName}
                    </h3>
                    <p class="text-[8px] sm:text-[9px] md:text-[10px] font-sans font-medium text-[#1F1A12]/80 mt-0.5 line-clamp-1">
                      {member.fullName}
                    </p>
                    <span class="text-[8px] font-mono font-bold uppercase tracking-widest text-[#8C6A1C] mt-2 block">
                      Buka Profil →
                    </span>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <div
      id="hero-bottom-glow"
      class="absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-[#D1C4E9]/50 via-[#EDE7F6]/30 to-transparent pointer-events-none z-10"
    ></div>
  </section>

  <section
    id="members-settled-section"
    class="relative w-full bg-[#FCFAF5] pt-14 pb-28 px-4 sm:px-8 border-t border-[#C9971C]/20 overflow-visible"
  >
    <div id="members-heading-wrap" class="max-w-7xl mx-auto w-full mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono font-bold tracking-[0.25em] uppercase text-[#C9971C] mb-1.5">
          <span class="w-2.5 h-0.5 bg-[#C9971C]"></span>
          <span>MEET THE MEMBERS</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-display font-black tracking-tight text-[#1F1A12] uppercase">
          7 Karakter, Satu Harmoni
        </h2>
        <p class="max-w-2xl text-[#6E6453] text-xs sm:text-sm md:text-base leading-relaxed mt-2">
          Kartu hero kini sejajar dalam harmoni penuh. Klik kartu member mana saja untuk membuka profil, karakteristik panggung, dan kisah mendalam mereka.
        </p>
      </div>
    </div>

    <div
      id="settled-target-container"
      class="relative w-full min-h-[275px] 2xl:min-h-[310px] flex items-center justify-center overflow-x-auto scrollbar-none overscroll-x-contain pb-4"
    >
      <div
        id="settled-cards-slot"
        class="w-full max-w-7xl mx-auto flex items-center justify-center min-w-max h-[265px] 2xl:h-[300px]"
      >
      </div>
    </div>
  </section>
</div>

<script>
  import { initHeroAnimation } from '../../animations/hero';

  const container = document.getElementById('hero-scroll-container');
  if (container) {
    initHeroAnimation(container);
  }
</script>
