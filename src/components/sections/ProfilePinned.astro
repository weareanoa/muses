---
import membersData from '../../data/members.json';
---

<section id="members-showcase-section" class="relative bg-[#FDF6E7]/60 py-20 px-4 sm:px-8 border-t border-[#C9971C]/20 overflow-hidden">
  <div class="max-w-7xl mx-auto w-full mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs font-mono font-bold tracking-[0.25em] uppercase text-[#C9971C] mb-1.5">
        <span class="w-2.5 h-0.5 bg-[#C9971C]"></span>
        <span>MEET THE MEMBERS</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-display font-black tracking-tight text-[#1F1A12] uppercase">
        7 Karakter, Satu Harmoni
      </h2>
      <p class="max-w-2xl text-[#6E6453] text-xs sm:text-sm leading-relaxed mt-1.5">
        MUSES terdiri dari tujuh member bertalenta: Aria, Clara, Stella, Faril, Maya, Reva, dan Zia. Klik kartu member mana saja untuk membuka profil dan kisah lengkap mereka.
      </p>
    </div>

  </div>

  <div id="members-pin-container" data-lenis-prevent class="relative w-full overflow-x-auto scrollbar-none overscroll-x-contain pb-4">
    <div
      id="members-track"
      class="flex gap-4 sm:gap-6 px-2 sm:px-6 w-max items-stretch select-none"
    >
      {
        membersData.map((member, index) => (
          <div
            class="member-card shrink-0 relative w-[240px] sm:w-[270px] lg:w-[290px] rounded-3xl bg-white border border-[#C9971C]/25 overflow-hidden flex flex-col justify-between transition-all duration-300 hover:border-[#C9971C] hover:shadow-[0_15px_35px_rgba(201,151,28,0.22)] hover:-translate-y-1.5 group cursor-pointer"
            data-member-id={member.id}
            data-member-name={member.stageName}
            data-member-index={index}
          >
            <div class="relative w-full aspect-[4/5] overflow-hidden bg-[#FDF6E7] shrink-0">
              <img
                src={member.photoFull || member.photoThumb}
                alt={member.stageName}
                width="600"
                height="750"
                loading="lazy"
                class="w-full h-full object-cover object-center filter contrast-105 group-hover:scale-105 transition-all duration-500 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent pointer-events-none" />

              <div
                class="absolute top-3 right-3 w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold shadow-md"
                style={{
                  background: `linear-gradient(135deg, ${member.gradientStart}, ${member.gradientEnd})`,
                  color: '#1F1A12',
                }}
              >
                {member.icon || member.emoticon}
              </div>

              <div class="absolute bottom-3 left-3 text-white pointer-events-none">
                <span class="text-[9px] font-mono tracking-widest uppercase opacity-80 block">
                  0{index + 1}
                </span>
                <span class="text-xl font-display font-black tracking-wider text-[#F7E08F]">
                  {member.stageName}
                </span>
              </div>
            </div>

            <div class="p-5 flex flex-col justify-between flex-1 bg-white space-y-2">
              <div>
                <span
                  class="text-[10px] font-mono tracking-wider uppercase font-bold px-2 py-0.5 rounded-full inline-block mb-1.5"
                  style={{
                    backgroundColor: `${member.themeColor}15`,
                    color: member.themeColor,
                    borderColor: `${member.themeColor}30`,
                  }}
                >
                  {member.role}
                </span>
                <h3 class="text-lg font-bold text-[#1F1A12] leading-tight">
                  {member.fullName}
                </h3>
                <p class="text-xs text-[#6E6453] mt-1 line-clamp-2">
                  {member.story01}
                </p>
              </div>

              <div className="pt-2 border-t border-[#1F1A12]/10 flex items-center justify-between text-xs font-mono font-semibold text-[#C9971C] group-hover:translate-x-1 transition-transform">
                <span>Lihat Profil</span>
                <span>→</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  function initMemberCardEvents() {
    const cards = document.querySelectorAll('.member-card');
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const memberId = card.getAttribute('data-member-id');
        if (memberId) {
          window.dispatchEvent(new CustomEvent('open-member-modal', { detail: memberId }));
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMemberCardEvents);
  } else {
    initMemberCardEvents();
  }
</script>
