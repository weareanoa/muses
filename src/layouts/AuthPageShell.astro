---
import RootLayout from './RootLayout.astro';
import AuthIsland from '../components/islands/AuthIsland';

interface Props {
  title?: string;
  description?: string;
  initialMode?: 'login' | 'register';
}

const {
  title = 'Masuk / Daftar Akun | MUSES Official Portal',
  description = 'Akses resmi MUSES Official Portal dengan Google atau Email OTP untuk pembelian tiket, merchandise, dan konten eksklusif.',
  initialMode,
} = Astro.props;
---

<RootLayout
  title={title}
  description={description}
  currentPath="/auth"
  hideNavbar={true}
>
  <div class="relative min-h-screen py-12 px-4 sm:px-6 flex items-center justify-center overflow-hidden bg-[#FCFAF5]">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-[#F7E08F]/20 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="relative z-10 w-full max-w-md mx-auto">
      <AuthIsland client:load initialMode={initialMode} />
    </div>
  </div>
</RootLayout>

