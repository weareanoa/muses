---
import '../styles/global.css';
import CartDrawer from '../components/islands/CartDrawer';
import MemberModal from '../components/islands/MemberModal';
import UserNavIsland from '../components/islands/UserNavIsland';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  solidHeader?: boolean;
  hideNavbar?: boolean;
}

const {
  title = 'MUSES | Official Idol Group Website',
  description = 'Situs resmi idol grup MUSES (7 members: Aria, Clara, Stella, Luna, Maya, Reva, Zia). Album, jadwal konser tur, galeri, dan merchandise resmi.',
  currentPath = Astro.url.pathname,
  solidHeader = false,
  hideNavbar = false,
} = Astro.props;

const navItems = [
  { name: 'HOME', href: '/' },
  { name: 'MEMBER', href: '/member' },
  { name: 'DISCOGRAPHY', href: '/discography' },
  { name: 'SCHEDULE', href: '/schedule' },
  { name: 'STORE', href: '/store' },
  { name: 'GALLERY', href: '/gallery' },
  { name: 'KONTAK', href: '/kontak' },
];

const isItemActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FCFAF5" />

    <title>{title}</title>
  </head>
  <body class="bg-[#FCFAF5] text-[#1F1A12] selection:bg-[#C9971C] selection:text-[#1F1A12]">
    {!hideNavbar && (
    <header
      id="main-header"
      class={`fixed top-0 inset-x-0 z-40 navbar-visible border-b border-[#C9971C]/25 bg-white/95 backdrop-blur-md shadow-xs`}
      data-solid-header={solidHeader ? 'true' : 'false'}
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-8 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group" aria-label="MUSES Home">
          <span class="text-2xl sm:text-3xl font-display font-black tracking-widest gold-gradient-text transition-transform group-hover:scale-105">
            MUSES
          </span>
        </a>

        <nav class="hidden lg:flex items-center gap-1.5 xl:gap-2 text-[11px] font-semibold tracking-wider uppercase text-[#6E6453]">
          {navItems.map((item) => {
            const active = isItemActive(item.href);
            return (
              <a
                href={item.href}
                class={`px-3.5 py-1.5 rounded-full transition-all duration-200 ${
                  active
                    ? 'pill-active'
                    : 'hover:text-[#1F1A12] hover:bg-[#C9971C]/10 text-[#524838]'
                }`}
              >
                {item.name}
              </a>
            );
          })}
        </nav>

        <div class="flex items-center gap-2.5 sm:gap-3">
          <button
            id="nav-cart-btn"
            class="relative p-2.5 rounded-full bg-[#FCFAF5] hover:bg-[#C9971C]/15 border border-[#C9971C]/30 text-[#1F1A12] transition-all cursor-pointer flex items-center justify-center group"
            aria-label="Keranjang Belanja"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#8C6A1C] group-hover:text-[#C9971C] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            <span
              id="cart-badge-count"
              class="absolute -top-1 -right-1 w-5 h-5 rounded-full gold-gradient-bg text-[#1F1A12] text-[10px] font-bold flex items-center justify-center shadow-[0_0_10px_rgba(201,151,28,0.6)]"
            >
              0
            </span>
          </button>

          <span class="h-6 w-px bg-[#C9971C]/30 mx-0.5" aria-hidden="true"></span>

          <UserNavIsland client:load />

          <button
            id="mobile-menu-btn"
            class="lg:hidden p-2.5 rounded-full bg-[#FCFAF5] hover:bg-[#C9971C]/15 border border-[#C9971C]/30 text-[#1F1A12] transition-all cursor-pointer flex items-center justify-center group"
            aria-label="Buka Menu Navigasi"
          >
            <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#8C6A1C] group-hover:text-[#C9971C] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#8C6A1C] group-hover:text-[#C9971C] transition-colors hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <div
      id="mobile-nav-drawer"
      class="fixed inset-x-0 top-20 z-30 bg-white/95 backdrop-blur-2xl border-b border-[#C9971C]/30 transition-all duration-300 ease-in-out -translate-y-full opacity-0 pointer-events-none lg:hidden shadow-xl"
    >
      <div class="px-6 py-6 flex flex-col space-y-4">
        <nav class="flex flex-col space-y-2 text-xs font-bold uppercase tracking-wider text-[#4B4335]">
          {navItems.map((item, idx) => {
            const active = isItemActive(item.href);
            return (
              <a
                href={item.href}
                class={`mobile-nav-link flex items-center justify-between py-2.5 px-3 rounded-xl border border-transparent transition-all ${
                  active
                    ? 'pill-active'
                    : 'hover:bg-[#C9971C]/10 text-[#4B4335]'
                }`}
              >
                <span>{item.name}</span>
                <span class="text-[10px] font-mono text-[#C9971C]">0{idx + 1}</span>
              </a>
            );
          })}
          <a
            href="/auth"
            class="mobile-nav-link flex items-center justify-between py-2.5 px-3 rounded-xl hover:bg-[#C9971C]/10 text-[#1F1A12] border-t border-[#1F1A12]/10 mt-2 pt-3"
          >
            <span>AKUN SAYA / SIGN IN</span>
            <span class="text-[10px] font-mono text-[#C9971C]">★</span>
          </a>
        </nav>
      </div>
    </div>
    )}

    <main class="min-h-screen">
      <slot />
    </main>

    <CartDrawer client:load />
    <MemberModal client:load />

    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { totalCartCount, openCart } from '../stores/cartStore';

      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        smoothWheel: true,
      });

      (window as any).__lenis = lenis;
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);

      const header = document.getElementById('main-header');
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileDrawer = document.getElementById('mobile-nav-drawer');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');
      const mobileLinks = document.querySelectorAll('.mobile-nav-link');
      const badge = document.getElementById('cart-badge-count');
      const cartBtn = document.getElementById('nav-cart-btn');

      let isMobileMenuOpen = false;
      let lastScrollY = typeof window !== 'undefined' ? window.scrollY : 0;
      let isHeaderHidden = false;

      function updateNavbar(scrollY: number, forceDirection?: number) {
        if (!header) return;
        if (isMobileMenuOpen) return;

        const currentY = Math.max(0, scrollY);
        const delta = currentY - lastScrollY;
        const direction = forceDirection !== undefined ? forceDirection : delta > 2 ? 1 : delta < -2 ? -1 : 0;

        if (currentY <= 60) {
          header.classList.remove('navbar-hidden', 'navbar-scrolled');
          header.classList.add('navbar-visible');
          header.style.transform = 'translateY(0)';
          isHeaderHidden = false;
          lastScrollY = currentY;
          return;
        }

        header.classList.add('navbar-scrolled');

        if (direction === 1 && !isHeaderHidden) {
          header.classList.remove('navbar-visible');
          header.classList.add('navbar-hidden');
          header.style.transform = 'translateY(-100%)';
          isHeaderHidden = true;
        } else if (direction === -1 && isHeaderHidden) {
          header.classList.remove('navbar-hidden');
          header.classList.add('navbar-visible');
          header.style.transform = 'translateY(0)';
          isHeaderHidden = false;
        }

        lastScrollY = currentY;
      }

      lenis.on('scroll', (e: any) => {
        updateNavbar(e.scroll, e.direction);
      });

      window.addEventListener('scroll', () => {
        if (window.scrollX !== 0) {
          window.scrollTo({ left: 0 });
        }
        updateNavbar(window.scrollY);
      }, { passive: true });

      updateNavbar(window.scrollY);

      totalCartCount.subscribe((count) => {
        if (badge) {
          badge.textContent = count.toString();
          badge.style.display = count > 0 ? 'flex' : 'none';
        }
      });

      cartBtn?.addEventListener('click', () => {
        openCart();
      });

      function toggleMobileMenu(open?: boolean) {
        isMobileMenuOpen = open !== undefined ? open : !isMobileMenuOpen;
        if (isMobileMenuOpen) {
          header?.classList.remove('navbar-hidden');
          header?.classList.add('navbar-visible');
          mobileDrawer?.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
          mobileDrawer?.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
          hamburgerIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        } else {
          mobileDrawer?.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
          mobileDrawer?.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
          updateNavbar(window.scrollY);
        }
      }

      mobileBtn?.addEventListener('click', () => toggleMobileMenu());
      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => toggleMobileMenu(false));
      });
    </script>
  </body>
</html>
