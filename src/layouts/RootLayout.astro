---
import { withBase } from "../lib/paths";
import '../styles/global.css';
import PreloaderBuffer from '../components/ui/PreloaderBuffer.astro';
import CartDrawer from '../components/islands/CartDrawer';
import MemberModal from '../components/islands/MemberModal';
import UserNavIsland from '../components/islands/UserNavIsland';
import { getDict, resolveLocale, LOCALE_COOKIE } from '../i18n/dictionary';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  solidHeader?: boolean;
  hideNavbar?: boolean;
}

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);

const {
  title = d.meta.defaultTitle,
  description = d.meta.defaultDesc,
  currentPath = Astro.url.pathname,
  solidHeader = false,
  hideNavbar = false,
} = Astro.props;

const navItems = [
  { name: d.nav.home, href: '/#home', id: 'home' },
  { name: d.nav.member, href: '/#member', id: 'member' },
  { name: d.nav.discography, href: '/#discography', id: 'discography' },
  { name: d.nav.schedule, href: '/#schedule', id: 'schedule' },
  { name: d.nav.gallery, href: '/#gallery', id: 'gallery' },
  { name: d.nav.store, href: '/#store', id: 'store' },
  { name: d.nav.contact, href: '/#kontak', id: 'kontak' },
];

const bottomNavItems = [
  { id: 'home', name: d.nav.home, href: '/#home', icon: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>' },
  { id: 'member', name: d.nav.member, href: '/#member', icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
  { id: 'discography', name: d.nav.album, href: '/#discography', icon: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="2"/>' },
  { id: 'schedule', name: d.nav.schedule, href: '/#schedule', icon: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>' },
  { id: 'store', name: d.nav.store, href: '/#store', icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>' },
];

const isItemActive =(id: string) => {
  const isHome = currentPath === '/' || currentPath === withBase('/') || currentPath === withBase('').replace(/\/$/, '');
  if (isHome) return id === 'home';
  const bPath = withBase('/' + id);
  return currentPath.startsWith(bPath);
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FCFAF5" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&display=swap" rel="stylesheet" />

    <title>{title}</title>
  </head>
  <body class="bg-[#FCFAF5] text-[#1F1A12] selection:bg-[#C9971C] selection:text-[#1F1A12]">
    <PreloaderBuffer locale={locale} />

    {!hideNavbar && (
    <header
      id="main-header"
      class="fixed top-0 inset-x-0 z-40 navbar-visible border-b border-[#C9971C]/25 bg-white/95 backdrop-blur-md shadow-xs"
      data-solid-header={solidHeader ? 'true' : 'false'}
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-8 h-14 lg:h-20 flex items-center justify-between">
        <a href={withBase("/")} class="flex items-center gap-2 group" aria-label={d.footer.homeAria}>
          <img
            src={withBase("/images/muses_logo_3d_clean.svg")}
            alt="MUSES"
            class="h-8 sm:h-9 md:h-10 w-auto object-contain transition-transform group-hover:scale-105"
          />
        </a>

        <nav class="hidden lg:flex items-center gap-1.5 xl:gap-2 text-[11px] font-semibold tracking-wider uppercase text-[#6E6453]">
          {navItems.map((item) => {
            const active = isItemActive(item.id);
            return (
              <a
                href={withBase(item.href)}
                data-nav-desktop
                data-nav-id={item.id}
                class={`nav-menu-link px-4 py-1.5 rounded-full transition-all duration-200 text-[11px] font-semibold tracking-wider uppercase ${
                  active
                    ? 'bg-gradient-to-r from-[#C28C1D] via-[#DBA736] to-[#A37418] text-[#1F1A12] shadow-xs'
                    : 'hover:text-[#1F1A12] hover:bg-[#C9971C]/10 text-[#524838]'
                }`}
              >
                {item.name}
              </a>
            );
          })}
        </nav>

        <UserNavIsland client:load locale={locale} />
      </div>
    </header>

    <nav
      aria-label={d.nav.mobileNavAria}
      class="lg:hidden fixed bottom-0 inset-x-0 z-40 border-t border-[#C9971C]/25 bg-white/95 backdrop-blur-md pb-[env(safe-area-inset-bottom)] shadow-[0_-4px_16px_rgba(90,70,30,0.08)]"
    >
      <ul class="grid grid-cols-5 h-16 max-w-xl mx-auto">
        {bottomNavItems.map((item) => (
          <li class="contents">
            <a
              href={withBase(item.href)}
              data-nav-bottom
              data-nav-id={item.id}
              data-active={isItemActive(item.id) ? 'true' : 'false'}
              aria-current={isItemActive(item.id) ? 'page' : undefined}
              class="relative flex flex-col items-center justify-center gap-1 text-[#6E6453] transition-colors active:bg-[#C9971C]/10 data-[active=true]:text-[#8C6A1C] before:absolute before:top-0 before:h-0.5 before:w-8 before:rounded-b-full before:bg-[#C9971C] before:opacity-0 before:transition-opacity data-[active=true]:before:opacity-100"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
              <span class="text-[10px] font-medium leading-none lowercase first-letter:uppercase">{item.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    )}

    <main class="min-h-screen pb-[calc(4rem+env(safe-area-inset-bottom))] lg:pb-0">
      <slot />
    </main>

    <CartDrawer client:idle locale={locale} />
    <MemberModal client:idle locale={locale} />

    <script>
      import { initSmoothScroll } from '../animations/scroll';
      import { initNavbar } from '../animations/navbar';

      initSmoothScroll();
      initNavbar();
    </script>
  </body>
</html>
