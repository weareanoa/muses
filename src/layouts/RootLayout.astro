---
import { withBase } from "../lib/paths";
import '../styles/global.css';
import CartDrawer from '../components/islands/CartDrawer';
import MemberModal from '../components/islands/MemberModal';
import UserNavIsland from '../components/islands/UserNavIsland';
import { getDict, resolveLocale, LOCALE_COOKIE } from '../i18n/dictionary';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  solidHeader?: boolean;
  hideNavbar?: boolean;
}

const locale = resolveLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const d = getDict(locale);

const {
  title = d.meta.defaultTitle,
  description = d.meta.defaultDesc,
  currentPath = Astro.url.pathname,
  solidHeader = false,
  hideNavbar = false,
} = Astro.props;

const navItems = [
  { name: d.nav.home, href: '/#home', id: 'home' },
  { name: d.nav.member, href: '/#member', id: 'member' },
  { name: d.nav.discography, href: '/#discography', id: 'discography' },
  { name: d.nav.schedule, href: '/#schedule', id: 'schedule' },
  { name: d.nav.gallery, href: '/#gallery', id: 'gallery' },
  { name: d.nav.store, href: '/#store', id: 'store' },
  { name: d.nav.contact, href: '/#kontak', id: 'kontak' },
];

const isItemActive =(id: string) => {
  const isHome = currentPath === '/' || currentPath === withBase('/') || currentPath === withBase('').replace(/\/$/, '');
  if (isHome) return id === 'home';
  const bPath = withBase('/' + id);
  return currentPath.startsWith(bPath);
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FCFAF5" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href={withBase("/fonts/Balbes.woff2")} as="font" type="font/woff2" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800;900&family=Cinzel+Decorative:wght@400;700;900&family=Poppins:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />

    <title>{title}</title>
  </head>
  <body class="bg-[#FCFAF5] text-[#1F1A12] selection:bg-[#C9971C] selection:text-[#1F1A12]">
    {!hideNavbar && (
    <header
      id="main-header"
      class="fixed top-0 inset-x-0 z-40 navbar-visible border-b border-[#C9971C]/25 bg-white/95 backdrop-blur-none sm:backdrop-blur-md shadow-xs"
      data-solid-header={solidHeader ? 'true' : 'false'}
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-8 h-14 lg:h-20 flex items-center justify-between">
        <a href={withBase("/")} class="flex items-center gap-2 group" aria-label={d.footer.homeAria}>
          <img
            src={withBase("/images/muses_logo_3d_clean.webp")}
            alt="MUSES"
            class="h-8 sm:h-9 md:h-10 w-auto object-contain transition-transform group-hover:scale-105"
          />
        </a>

        <nav class="hidden lg:flex items-center gap-1.5 xl:gap-2 text-[11px] font-semibold tracking-wider uppercase text-[#6E6453]">
          {navItems.map((item) => {
            const active = isItemActive(item.id);
            return (
              <a
                href={withBase(item.href)}
                data-nav-desktop
                data-nav-id={item.id}
                class={`nav-menu-link px-4 py-1.5 rounded-full transition-all duration-200 text-[11px] font-semibold tracking-wider uppercase ${
                  active
                    ? 'bg-muses-gradient text-[#1F1A12] shadow-xs'
                    : 'hover:text-[#1F1A12] hover:bg-[#C9971C]/10 text-[#524838]'
                }`}
              >
                {item.name}
              </a>
            );
          })}
        </nav>

        <UserNavIsland client:idle locale={locale} />
      </div>
    </header>

    )}

    <main class="min-h-svh">
      <slot />
    </main>

    <CartDrawer client:load locale={locale} />
    <MemberModal client:idle locale={locale} />

    <script>
      import { initSmoothScroll } from '../animations/scroll';
      import { initNavbar } from '../animations/navbar';

      initSmoothScroll();
      initNavbar();
    </script>
  </body>
</html>
